# Copie para terraform.tfvars (ignorado pelo git) e preencha. Nenhum segredo vai aqui.
domain_name        = "homologacao.exemplo.com.br"
hosted_zone_id     = "Z0000000000000000000"
email_from         = "nao-responda@exemplo.com.br"
email_domain       = "exemplo.com.br"
rights_channel_url = "https://exemplo.com.br/privacidade"

# Na primeira aplicacao, antes de existir imagem no ECR, use uma imagem publica qualquer e rode
# o CD depois; nas seguintes, o CD informa os digests.
api_image = "111111111111.dkr.ecr.sa-east-1.amazonaws.com/meuremedio-homologacao-api@sha256:..."
web_image = "111111111111.dkr.ecr.sa-east-1.amazonaws.com/meuremedio-homologacao-web@sha256:..."
