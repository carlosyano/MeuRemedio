{
  "name": "meuremedio",
  "version": "0.0.0",
  "private": true,
  "description": "MeuRemedio - monorepo (fundacao tecnica Test-First)",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "ops": "node apps/api/dist/ops-main.js",
    "typecheck": "tsc -b && tsc -p tests/tsconfig.json && tsc -p apps/web/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run --project unit",
    "openapi:lint": "node tools/scripts/openapi-lint.mjs",
    "openapi:diff": "node tools/scripts/openapi-diff.mjs",
    "traceability:check": "python validate_all.py",
    "trace:check": "node tools/scripts/trace-check.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit && npm run test:contract && npm run openapi:lint && npm run openapi:diff",
    "test:contract": "vitest run --project contract",
    "test:integration": "vitest run --project integration",
    "test:schemathesis": "vitest run --project schemathesis",
    "test:ownership": "vitest run --project integration tests/security/ts-023.spec.ts",
    "sbom": "node tools/scripts/sbom.mjs",
    "test:mutation": "stryker run",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@stoplight/spectral-core": "1.24.0",
    "@stoplight/spectral-parsers": "1.0.5",
    "@stoplight/spectral-rulesets": "1.23.0",
    "@stryker-mutator/core": "10.0.0",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "glob": "13.0.6"
  },
  "overrides": {
    "qs": "6.16.0",
    "playwright-core": "1.63.0"
  }
}
